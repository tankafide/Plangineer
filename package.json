{
  "name": "plangineer",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "pnpm --filter @plangineer/desktop start",
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "node scripts/db-up.mjs",
    "db:migrate": "pnpm --filter @plangineer/api db:migrate",
    "db:reset": "pnpm --filter @plangineer/api db:reset",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --type-check",
    "typecheck": "turbo run typecheck",
    "deps:check": "depcruise --config .dependency-cruiser.cjs --output-type err-long apps packages",
    "knip": "knip",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "runner": "node apps/runner/src/cli.ts",
    "runner:fake": "node scripts/runner-fake.mjs",
    "runner:build": "pnpm --filter plangineer-runner build",
    "runner:publish": "node scripts/publish-runner.mjs",
    "skills:sync": "node apps/runner/src/cli.ts skills sync",
    "skills:lint": "node scripts/lint-skills.mjs",
    "skills:check": "node apps/runner/src/cli.ts skills check",
    "verify": "node scripts/verify.mjs",
    "worktree:new": "node scripts/worktree-new.mjs",
    "auto:run": "node scripts/auto-run.mjs"
  },
  "devDependencies": {
    "@swc/core": "1.16.13",
    "dependency-cruiser": "18.5.0",
    "electron-builder": "26.15.3",
    "execa": "10.1.0",
    "knip": "6.40.0",
    "lefthook": "2.1.17",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tar": "7.5.22",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.6"
}
