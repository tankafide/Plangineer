# API
DATABASE_URL=postgres://plangineer:plangineer@localhost:5432/plangineer
API_HOST=127.0.0.1
API_PORT=3000
API_LOG_FILE=../../logs/api.log
LOG_LEVEL=info
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:5173
# Guards GitHub App creation on the Get started screen. pnpm setup:env writes a random one.
SETUP_TOKEN=replace-with-32-or-more-random-characters
RUNNER_HEARTBEAT_INTERVAL_MS=10000
RUN_LEASE_DURATION_MS=30000
RUNNER_OFFLINE_AFTER_MS=30000
RUN_SWEEP_INTERVAL_MS=5000
RUN_MAX_ATTEMPTS=3
SSE_KEEPALIVE_INTERVAL_MS=15000
RUNNER_LOGIN_TTL_MS=600000
# WEB_DIST_DIR=<absolute path to apps/web/dist; unset in dev, where Vite serves the web app>

# Runner
# The runner reads its shell environment, not this file. Every variable is optional.
# PLANGINEER_RUNNER_DATA_DIR=<absolute path; defaults to the user data directory>
# PLANGINEER_RUNNER_CONCURRENCY=2
# PLANGINEER_CLAUDE_COMMAND=["claude"]
# PLANGINEER_GIT_BASE_URL=https://github.com
# PLANGINEER_RUN_TIMEOUT_MS=3600000
# LOG_LEVEL=info
