{
  "name": "@plangineer/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch src/main.ts",
    "start": "node --env-file=../../.env src/main.ts",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env src/db/migrate-cli.ts",
    "db:reset": "node --env-file=../../.env src/db/reset.ts",
    "e2e:session": "node --env-file=../../.env src/test/e2e-session-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@orpc/server": "1.15.5",
    "@plangineer/contracts": "workspace:*",
    "@plangineer/domain": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "execa": "10.1.0",
    "vitest": "5.0.3"
  }
}
