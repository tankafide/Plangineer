    "@plangineer/contracts": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "electron": "44.7.0",
    "electron-updater": "6.8.9",
    "env-paths": "4.0.0",
    "execa": "10.1.0",
    "shell-env": "4.0.3",
    "tsdown": "0.23.0",
    "vitest": "5.0.3"
  }
}
