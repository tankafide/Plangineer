{
  "name": "@plangineer/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Plangineer for your desktop: the API, web app, Postgres and runner on your own computer.",
  "author": "Shane Stewart",
  "type": "module",
  "main": "dist/main.mjs",
